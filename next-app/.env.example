# Copy this file to .env.local for running on your PC. On Vercel, set the same names in the project's
# Environment Variables (DATABASE_URL is added for you when you connect the Postgres database).

# Postgres connection string (Vercel Storage -> Neon adds this for you)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Long random text used to sign the login cookie (at least 32 characters).
# Make one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Your admin login. Get the hash line with:  npm run hash
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD_HASH_B64=

# Only for testing on plain http on your PC; leave unset on Vercel
# COOKIE_SECURE=false
